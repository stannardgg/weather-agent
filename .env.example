# 配置模板（CLAUDE.md §12）。复制为 .env 后填写真实值；.env 禁止提交到 git。
APP_ENV=dev
APP_NAME=weather-agent
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# JWT 签名密钥：至少 32 字节（不足会在启动时直接报错，见 core/config.py 的校验）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 非 dev 环境必须替换，且不允许以 dev-only 开头
SECRET_KEY=dev-only-secret-key-change-me-in-production
# JWT 参数：HS256 为对称签名算法；access token 有效期默认 12 小时
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 注意驱动前缀 sqlite+aiosqlite —— 异步 ORM 必须用异步驱动
DATABASE_URL=sqlite+aiosqlite:///./data/weather_agent.db
# 设为 true 会把每条 SQL 打印到日志，排查问题时才开
SQL_ECHO=false
VECTOR_STORE_TYPE=chroma
CHROMA_DIR=./data/chroma

# 🔑 以下三项是**大模型**的凭据，与下面的和风天气无关（两家公司、两套账号、两套计费）。
# 获取入口：https://platform.deepseek.com/api_keys → 创建 API Key → 只显示一次，立即复制。
# API 调用按 token 从账户余额扣费，不是免费无限额度。
#
# base_url 用官方文档给的值（不带 /v1）。langchain-openai 会在它后面拼 /chat/completions。
#   OpenAI 兼容：https://api.deepseek.com
#   Anthropic 兼容：https://api.deepseek.com/anthropic（本项目不用）
# 其它 OpenAI 兼容网关（通义 / 智谱 / 本地 vLLM / Ollama）同样只需改这三个值。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 模型名。2026-10-12 核对官方文档（api-docs.deepseek.com）：当前只有两个可用模型。
#   deepseek-flash   = DeepSeek-V4.1-Flash，1M 上下文，支持思考模式，便宜
#   deepseek-v4-pro  = DeepSeek-V4-Pro-0813，旗舰，价格约 4 倍
# ⚠️ 旧名 deepseek-chat / deepseek-reasoner 已下线，写了会直接报错。
LLM_MODEL=deepseek-flash
# 生成温度。天气播报与知识库问答都要「贴着材料说」，取低值减少发挥。
LLM_TEMPERATURE=0.3
# 单次 LLM 调用超时（秒）。流式响应下这是「整体上限」而不是「首个 token 的等待上限」。
LLM_TIMEOUT_SECONDS=60

WEATHER_PROVIDER=qweather
# 和风天气的 API Host 是「每个项目独立分配」的（形如 xxxxx.qweatherapi.com），
# 不再有固定的公共域名，必须从控制台复制；只填域名，不要带 https://
WEATHER_API_HOST=
# 认证密钥。项目约定放请求头 X-QW-Api-Key，不放查询参数
WEATHER_API_KEY=
# 单次请求超时（秒）、5xx 与网络异常的重试次数、缓存有效期（秒）
WEATHER_TIMEOUT_SECONDS=8
WEATHER_MAX_RETRIES=2
WEATHER_CACHE_TTL_SECONDS=900

MAX_UPLOAD_SIZE_MB=20
# 切分参数：重叠必须小于块大小，否则启动即报错（切分窗口无法前进）
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVE_TOP_K=5

# --- M3/M4 向量化与知识库存储 ---
# 上传文件落盘根目录；实际路径为 {UPLOAD_DIR}/{user_id}/{hash前16}_{安全文件名}
UPLOAD_DIR=./data/uploads
# Chroma 集合名（测试与冒烟脚本会换成独立名字，避免相互污染）
CHROMA_COLLECTION=knowledge

# 向量化实现（D-M4-1 决策）：fastembed = 本地 ONNX 真实模型，检索有语义。
# placeholder = 开发期占位替身（结构真、语义假），非 dev 环境设它会启动失败。
EMBEDDING_PROVIDER=fastembed
# 模型名。改这里必须同时改 EMBEDDING_DIM 并重建索引，否则新老向量不在同一坐标系，
# 检索结果会毫无意义。含中文能力的候选（fastembed 清单实测）：
#   BAAI/bge-small-zh-v1.5  (512 维, 90MB, MIT)       ← 默认
#   jinaai/jina-embeddings-v2-base-zh  (768 维, 640MB, Apache-2.0)
#   intfloat/multilingual-e5-large  (1024 维, 2.24GB, MIT)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 模型真实输出维度。与模型不匹配会在构造向量化器时**直接报错**（而不是悄悄存错维度）。
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=32

# 模型下载源。huggingface.co 在部分网络环境下不可达，故默认走镜像；
# 能直连 HuggingFace 的环境改成 https://huggingface.co。
# 模型只在首次运行时下载一次，之后完全离线。
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录。放在项目内是为了「私有化离线部署时把整个目录拷到目标机器」。
FASTEMBED_CACHE_PATH=./data/models/fastembed

# 检索查询的指令前缀。不设 = 按模型名自动判断（bge-zh 系列会加）；
# 显式设为空字符串 = 强制不加，用于在自己的真实语料上做 A/B。
# 详见 app/rag/embedder.py 顶部对「加不加有多大差别」的实测记录。
# EMBEDDING_QUERY_INSTRUCTION=

# 文档详情接口回传几个切分片段供前端预览
DOCUMENT_PREVIEW_CHUNKS=5

# --- M4：检索问答 ---
# 向量检索的余弦距离阈值（0 = 完全相同，2 = 完全相反；余弦距离 = 1 - 余弦相似度）。
# 超过该阈值的片段视为「不相关」直接丢弃，宁可不答也不拿无关材料喂模型。
# 调大 = 更宽松（更容易召回）；调小 = 更严格（更容易判定「知识库中未找到」）。
RETRIEVE_SCORE_THRESHOLD=0.45
# 组装 prompt 时最多带回几条历史消息（用户与助手各算一条）
CHAT_HISTORY_MAX_MESSAGES=20
# 单次提问的最大字符数，超出直接 400（防止超长输入烧 token）
CHAT_MAX_QUESTION_CHARS=2000
# 检索片段拼进 prompt 的总字符上限，超出按相关度从低到高截断
CHAT_MAX_RETRIEVED_CHARS=4000

# --- M6：企业级加固（限流 / 指标 / LLM 弹性）---
# 是否开启进程内限流。测试与本地排查可设 false 临时关闭。
RATE_LIMIT_ENABLED=true
# 限流按「来源 IP + 分组」三档滑动窗口（单位：次 / 秒）：
# auth = 注册/登录（防撞库与批量注册）；chat = 问答（防单用户打爆 LLM 配额）；default = 其余接口。
# 配成 0 会让对应接口被永久拒绝（启动校验会拦截）；window 必须 > 0。
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_LIMIT=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# 是否暴露 GET /metrics（Prometheus 文本格式）。设 false 时该端点返回 404。
METRICS_ENABLED=true

# LLM 调用的有限重试次数。只对网络异常与 5xx/429 重试（SDK 内部指数退避），
# 4xx 不重试（密钥错/参数错重试一万次也不会好）。最终失败返回友好兜底文案。
LLM_MAX_RETRIES=2
